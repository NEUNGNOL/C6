<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" class="root">
	<ui:Label name="total-label" text="작업 00:00" class="total" />
        <ui:VisualElement name="face-image" class="face" />
        <ui:Label name="stage-label" text="0 / 4 단계" class="stage" />
        <ui:Label name="timer-label" text="00:00" class="timer" />
        <ui:Button name="recover-button" text="스트레칭 완료!" class="recover-btn" />
    </ui:VisualElement>
</ui:UXML>