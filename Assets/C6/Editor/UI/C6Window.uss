.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 16px;
}

.total {
    font-size: 11px;
    opacity: 0.6;
    margin-bottom: 8px;
}

.face {
    width: 160px;
    height: 160px;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.stage {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.timer {
    font-size: 12px;
    opacity: 0.7;
    margin-bottom: 16px;
}

.recover-btn {
    height: 32px;
    width: 140px;
    font-size: 13px;
}

.urgent {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(230, 90, 90);
    opacity: 1;
}